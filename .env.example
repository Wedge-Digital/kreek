# Convention : un fichier par profil, `.env.<profil>`, choisi par EXEC_PROFILE.
# Un profil dont la base vit **ailleurs que sur la machine** se nomme
# `.env.remote.<nom>` — aujourd'hui `.env.remote.demo`, le seul. Le préfixe est
# là pour qu'on le lise avant de lancer une cible destructrice.
#
# Les cibles destructrices refusent d'ailleurs tout hôte non local, sauf
# I_KNOW_THIS_IS_REMOTE=1 : le nom informe, la garde empêche.

ENV=
DATABASE__URL=
# Accès admin (droits CREATEDB), connecté sur une base de maintenance (ex.
# 'postgres'), jamais sur DATABASE__NAME. Utilisé uniquement par
# `make init_demo_db` pour DROP/CREATE DATABASE ... OWNER DATABASE__USER —
# inutile pour les profils dev/test.
DATABASE__ADMIN_URL=
DATABASE__HOST=
DATABASE__PORT=
DATABASE__USER=
DATABASE__PWD=
DATABASE__NAME=
DATABASE__MAX_CONNECTIONS=
SERVER__HOST=
SERVER__PORT=
SQLX_OFFLINE=
RESEND_API_KEY=
# console = les emails sont écrits sur la sortie standard, rien n'est expédié.
# resend  = envoi réel, EMAIL__API_KEY obligatoire. Défaut : resend.
EMAIL__PROVIDER=
EMAIL__FROM=
EMAIL__API_KEY=
EMAIL__FROM_NAME=
HOST_DOMAIN=http://localhost:3210
REFERENCES__DIR=
# Niveau de journalisation de l'application — un niveau seul (`info`, `debug`…),
# pas une directive. Vide = `info`. Le ciblage fin passe par RUST_LOG, qui
# supplante ce réglage : RUST_LOG=kreek::app::players=debug
LOG__LEVEL=
